+                owner = declaringClass != null ? emit(() -> declaringClass.asJavaClass()) : emit(() -> {
+                    NoClassDefFoundError error = new NoClassDefFoundError(declaring);
+                    error.initCause(new ClassNotFoundException(declaring));
