@@ -0,0 +1,170 @@
+package org.teavm.classlib.impl.reflection;
+
+import java.lang.annotation.Annotation;
+import java.lang.reflect.AnnotatedType;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.GenericDeclaration;
+import java.lang.reflect.Method;
+import java.lang.reflect.Type;
+import java.lang.reflect.TypeVariable;
+
+public final class GenericMetadata {
+    public TypeVariable<?>[] parameters = new TypeVariable<?>[0];
+    public Type superclass;
+    public boolean superclassInitialized;
+    public boolean interfacesInitialized;
+    private Type[] interfaces = new Type[0];
+
+    public void initializeInterfaces(int count) {
+        interfaces = new Type[count];
+    }
+
+    public void setInterface(int index, Type type) {
+        interfaces[index] = type;
+    }
+
+    public Type[] getInterfaces() {
+        return interfaces.clone();
+    }
+
+    public static TypeVariable<?> variable(GenericDeclaration owner, String name) {
+        for (TypeVariable<?> variable : owner.getTypeParameters()) {
+            if (variable.getName().equals(name)) {
+                return variable;
+            }
+        }
+        throw new IllegalStateException("Missing type variable " + owner + "." + name);
+    }
+
+    public static Variable variablePlaceholder(GenericDeclaration owner, String name) {
+        return new Variable(owner, name);
+    }
+
+    public static final class Signature {
+        private final String name;
+        private final String result;
+        private final String[] parameters;
+
+        public Signature(String name, String result, int parameterCount) {
+            this.name = name;
+            this.result = result;
+            parameters = new String[parameterCount];
+        }
+
+        public void setParameter(int index, String type) {
+            parameters[index] = type;
+        }
+
+        public GenericDeclaration declaration(Class<?> owner) {
+            if (name.equals("<init>")) {
+                for (Constructor<?> constructor : owner.getDeclaredConstructors()) {
+                    if (matches(constructor)) return constructor;
+                }
+            } else {
+                for (Method method : owner.getDeclaredMethods()) {
+                    if (matches(method)) return method;
+                }
+            }
+            throw new IllegalStateException("Missing generic declaration " + owner.getName() + "." + name);
+        }
+
+        public boolean matches(GenericDeclaration declaration) {
+            if (declaration instanceof Method) {
+                Method method = (Method) declaration;
+                return method.getName().equals(name) && method.getReturnType().getName().equals(result)
+                        && matchesParameters(method.getParameterTypes());
+            }
+            return declaration instanceof Constructor<?> && name.equals("<init>") && result.equals("void")
+                    && matchesParameters(((Constructor<?>) declaration).getParameterTypes());
+        }
+
+        private boolean matchesParameters(Class<?>[] types) {
+            if (types.length != parameters.length) return false;
+            for (int i = 0; i < types.length; i++) {
+                if (!types[i].getName().equals(parameters[i])) return false;
+            }
+            return true;
+        }
+    }
+
+    public static final class Variable implements TypeVariable<GenericDeclaration> {
+        private final GenericDeclaration owner;
+        private final String name;
+        private Type[] bounds;
+
+        private Variable(GenericDeclaration owner, String name) {
+            this.owner = owner;
+            this.name = name;
+        }
+
+        public void initializeBounds(int count) {
+            bounds = new Type[count];
+        }
+
+        public void setBound(int index, Type type) {
+            bounds[index] = type;
+        }
+
+        @Override
+        public Type[] getBounds() {
+            return bounds.clone();
+        }
+
+        @Override
+        public GenericDeclaration getGenericDeclaration() {
+            return owner;
+        }
+
+        @Override
+        public String getName() {
+            return name;
+        }
+
+        @Override
+        public String getTypeName() {
+            return name;
+        }
+
+        @Override
+        public String toString() {
+            return name;
+        }
+
+        @Override
+        public boolean equals(Object other) {
+            if (!(other instanceof TypeVariable<?>)) {
+                return false;
+            }
+            TypeVariable<?> variable = (TypeVariable<?>) other;
+            return owner.equals(variable.getGenericDeclaration()) && name.equals(variable.getName());
+        }
+
+        @Override
+        public int hashCode() {
+            return owner.hashCode() ^ name.hashCode();
+        }
+
+        // Type-use annotations are not retained by this compiler, so a type variable reports none.
+        // (Browser port: these used to be link-time failures, but Gson's record reflection makes
+        // host-JDK code such as JMX introspection linkable even though it never runs.)
+        @Override
+        public AnnotatedType[] getAnnotatedBounds() {
+            return new AnnotatedType[0];
+        }
+
+        @Override
+        public <T extends Annotation> T getAnnotation(Class<T> annotationClass) {
+            return null;
+        }
+
+        @Override
+        public Annotation[] getAnnotations() {
+            return new Annotation[0];
+        }
+
+        @Override
+        public Annotation[] getDeclaredAnnotations() {
+            return new Annotation[0];
+        }
+    }
+}
