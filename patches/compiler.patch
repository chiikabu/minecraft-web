new file mode 100644
index 0000000..b50b0bd
--- /dev/null
+++ b/core/src/main/java/org/teavm/dependency/PendingTypes.java
@@ -0,0 +1,104 @@
+package org.teavm.dependency;
+
+import com.carrotsearch.hppc.IntHashSet;
+import com.carrotsearch.hppc.procedures.IntProcedure;
+import java.util.BitSet;
+
+/** Primitive queued type IDs; dense sets do not need a hash table per edge. */
+public final class PendingTypes {
+    private IntHashSet sparse;
+    private BitSet dense;
+    private int denseSize;
+    private int maximum;
+
+    PendingTypes(int capacity) {
+        sparse = new IntHashSet(capacity);
+    }
+
+    boolean contains(int value) {
+        return dense != null ? dense.get(value) : sparse.contains(value);
+    }
+
+    void add(int value) {
+        if (dense != null) {
+            if (!dense.get(value)) {
+                dense.set(value);
+                denseSize++;
+            }
+        } else if (sparse.add(value)) {
+            maximum = Math.max(maximum, value);
+            // Convert only when bitmap payload needs at most four bytes per member.
+            if (sparse.size() >= 64 && maximum < sparse.size() * 32L) {
+                dense = new BitSet(maximum + 1);
+                sparse.forEach((IntProcedure) dense::set);
+                denseSize = sparse.size();
+                sparse = null;
+            }
+        }
+    }
+
+    void addAll(BitSet values) {
+        int count = values.cardinality();
+        if (count < 64 || Math.max(values.length(), maximum + 1L) >= count * 32L) {
+            for (int value = values.nextSetBit(0); value >= 0; value = values.nextSetBit(value + 1)) {
+                add(value);
+            }
+            return;
+        }
+        if (dense == null) {
+            dense = (BitSet) values.clone();
+            sparse.forEach((IntProcedure) dense::set);
+            sparse = null;
+        } else {
+            dense.or(values);
+        }
+        denseSize = dense.cardinality();
+    }
+
+    public int size() {
+        return dense != null ? denseSize : sparse.size();
+    }
+
+    DependencyType[] remainingTypes(DependencyNode destination) {
+        var types = destination.dependencyAnalyzer.types;
+        if (dense != null) {
+            if (destination.typeSet != null) destination.typeSet.removeTypes(dense);
+            denseSize = dense.cardinality();
+            var result = new DependencyType[denseSize];
+            int index = 0;
+            for (int value = dense.nextSetBit(0); value >= 0; value = dense.nextSetBit(value + 1)) {
+                result[index++] = types.get(value);
+            }
+            return result;
+        }
+        // Compact a snapshot: deleting hash entries reorders surviving deliveries.
+        int[] values = sparse.toArray();
+        int count = 0;
+        for (int value : values) {
+            if (!destination.hasType(types.get(value))) values[count++] = value;
+        }
+        var result = new DependencyType[count];
+        for (int i = 0; i < count; i++) {
+            result[i] = types.get(values[i]);
+        }
+        return result;
+    }
+
+    void forEach(IntProcedure procedure) {
+        if (dense == null) {
+            sparse.forEach(procedure);
+        } else {
+            for (int value = dense.nextSetBit(0); value >= 0; value = dense.nextSetBit(value + 1)) {
+                procedure.apply(value);
+            }
+        }
+    }
+
+    public int[] toArray() {
+        return dense != null ? dense.stream().toArray() : sparse.toArray();
+    }
+
+    public long storageBytes() {
+        return dense != null ? dense.size() / 8L : sparse.keys.length * 4L;
+    }
+}
