+package org.teavm.classlib.impl.reflection;
+
+import static org.teavm.metaprogramming.Metaprogramming.arrayClass;
+import static org.teavm.metaprogramming.Metaprogramming.emit;
+import static org.teavm.metaprogramming.Metaprogramming.exit;
+import static org.teavm.metaprogramming.Metaprogramming.findClass;
+import static org.teavm.metaprogramming.Metaprogramming.getDiagnostics;
+import static org.teavm.metaprogramming.Metaprogramming.getLocation;
+import static org.teavm.metaprogramming.Metaprogramming.lazyFragment;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.GenericDeclaration;
+import java.lang.reflect.Type;
+import java.lang.reflect.TypeVariable;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.teavm.metaprogramming.CompileTime;
+import org.teavm.metaprogramming.Meta;
+import org.teavm.metaprogramming.ReflectClass;
+import org.teavm.metaprogramming.Value;
+import org.teavm.metaprogramming.impl.reflect.ReflectClassImpl;
+import org.teavm.model.ClassReader;
+import org.teavm.model.ElementModifier;
+import org.teavm.model.GenericTypeParameter;
+import org.teavm.model.GenericValueType;
+import org.teavm.model.MethodReader;
+import org.teavm.model.MethodReference;
+import org.teavm.model.ValueType;
+
+@CompileTime
+public final class GenericMetadataGenerator {
+    private GenericMetadataGenerator() {
+    }
+
+    private static boolean isSyntheticTeaVm(String name) {
+        return name.startsWith("~") || name.contains("$lambda$_") || name.contains("$PROXY$")
+                || name.startsWith("$$teavm_generated_class$$") || name.startsWith("org.teavm.");
+    }
+
+    @Meta
+    public static native Class<?>[] declaredClasses(Class<?> owner);
+
+    public static void declaredClasses(ReflectClass<?> owner) {
+        if (owner.isPrimitive() || owner.isArray() || isSyntheticTeaVm(owner.getName())) {
+            exit(() -> new Class<?>[0]);
+            return;
+        }
+        if (missingOwner(owner)) return;
+        var declared = reader(owner).getDeclaredClasses();
+        for (String name : declared) {
+            var member = findClass(name);
+            String missing = member == null ? name
+                    : ((ReflectClassImpl<?>) member).findMissingClassInHierarchy();
+            if (missing != null) {
+                exit(() -> {
+                    NoClassDefFoundError error = new NoClassDefFoundError(missing);
+                    error.initCause(new ClassNotFoundException(missing));
+                    throw error;
+                });
+                return;
+            }
+        }
+        int count = declared.size();
+        Value<Class<?>[]> result = emit(() -> new Class<?>[count]);
+        int index = 0;
+        for (String name : declared) {
+            var member = findClass(name);
+            int position = index++;
+            emit(() -> result.get()[position] = member.asJavaClass());
+        }
+        exit(() -> result.get());
+    }
+
+    @Meta
+    public static native void fill(Class<?> owner, GenericMetadata metadata);
+
+    public static void fill(ReflectClass<?> owner, Value<GenericMetadata> metadata) {
+        if (owner.isPrimitive() || owner.isArray() || isSyntheticTeaVm(owner.getName())) {
+            exit();
+            return;
+        }
+        if (missingOwner(owner)) return;
+        ClassReader cls = reader(owner);
+        var declared = cls.getGenericParameters();
+        if (declared != null && declared.length > 0) {
+            Value<GenericDeclaration> declaration = emit(() -> owner.asJavaClass());
+            parameters(declared, cls, null, declaration, metadata);
+        }
+        exit();
+    }
+
+    @Meta
+    public static native void fillSuperclass(Class<?> owner, GenericMetadata metadata);
+
+    public static void fillSuperclass(ReflectClass<?> owner, Value<GenericMetadata> metadata) {
+        if (owner.isPrimitive() || owner.isArray() || isSyntheticTeaVm(owner.getName())) {
+            exit();
+            return;
+        }
+        if (missingOwner(owner)) return;
+        ClassReader cls = reader(owner);
+        if (!owner.isInterface() && cls.getGenericParent() != null) {
+            Value<Type> parent = type(cls.getGenericParent(), cls);
+            emit(() -> metadata.get().superclass = parent.get());
+        }
+        exit();
+    }
+
+    @Meta
+    public static native void fillInterfaces(Class<?> owner, GenericMetadata metadata);
+
+    public static void fillInterfaces(ReflectClass<?> owner, Value<GenericMetadata> metadata) {
+        if (owner.isPrimitive() || owner.isArray() || isSyntheticTeaVm(owner.getName())) {
+            exit();
+            return;
+        }
+        if (missingOwner(owner)) return;
+        ClassReader cls = reader(owner);
+        if (!cls.getGenericInterfaces().isEmpty()) {
+            List<Value<Type>> interfaces = new ArrayList<>();
+            for (var iface : cls.getGenericInterfaces()) {
+                interfaces.add(type(iface, cls));
+            }
+            int count = interfaces.size();
+            emit(() -> metadata.get().initializeInterfaces(count));
+            for (int i = 0; i < count; ++i) {
+                int index = i;
+                Value<Type> iface = interfaces.get(i);
+                emit(() -> metadata.get().setInterface(index, iface.get()));
+            }
+        }
+        exit();
+    }
+
+    @Meta
+    public static native Type fieldType(Class<?> owner, String fieldName, Type erasedType);
+
+    public static void fieldType(ReflectClass<?> owner, Value<String> fieldName, Value<Type> erasedType) {
+        if (owner.isPrimitive() || owner.isArray() || isSyntheticTeaVm(owner.getName())) {
+            exit(() -> erasedType.get());
+            return;
+        }
+        if (missingOwner(owner)) return;
+        ClassReader cls = reader(owner);
+        Value<Type> result = erasedType;
+        for (var field : cls.getFields()) {
+            if (field.getGenericType() == null) {
+                continue;
+            }
+            String name = field.getName();
+            Value<Type> previous = result;
+            Value<Type> resolved = lazyFragment(() -> type(field.getGenericType(), cls));
+            result = emit(() -> name.equals(fieldName.get()) ? resolved.get() : previous.get());
+        }
+        Value<Type> selected = result;
+        exit(() -> selected.get());
+    }
+
+    @Meta
+    public static native void fillMember(Class<?> owner, GenericDeclaration member, GenericMetadata metadata);
+
+    public static void fillMember(ReflectClass<?> owner, Value<GenericDeclaration> member,
+            Value<GenericMetadata> metadata) {
+        if (owner.isPrimitive() || owner.isArray() || isSyntheticTeaVm(owner.getName())) {
+            exit();
+            return;
+        }
+        if (missingOwner(owner)) return;
+        ClassReader cls = reader(owner);
+        for (MethodReader method : cls.getMethods()) {
+            if (method.getTypeParameters().length == 0) continue;
+            Value<GenericMetadata.Signature> signature = signature(method.getReference());
+            Value<TypeVariable<?>[]> initialized = lazyFragment(() ->
+                    parameters(method.getTypeParameters(), cls, method, member, metadata));
+            emit(() -> {
+                if (signature.get().matches(member.get())) {
+                    metadata.get().parameters = initialized.get();
+                }
+            });
+        }
+        exit();
+    }
+
+    @Meta
+    public static native Type[] constructorParameterTypes(Class<?> owner, Constructor<?> member, Type[] erasedTypes);
+
+    public static void constructorParameterTypes(ReflectClass<?> owner, Value<Constructor<?>> member,
+            Value<Type[]> erasedTypes) {
+        if (owner.isPrimitive() || owner.isArray() || isSyntheticTeaVm(owner.getName())) {
+            exit(() -> erasedTypes.get());
+            return;
+        }
+        if (missingOwner(owner)) return;
+        ClassReader cls = reader(owner);
+        Value<Type[]> result = erasedTypes;
+        for (MethodReader method : cls.getMethods()) {
+            if (!method.getName().equals("<init>") || method.getGenericResultType() == null) continue;
+            Value<GenericMetadata.Signature> signature = signature(method.getReference());
+            Value<Type[]> resolved = lazyFragment(() -> {
+                int count = method.genericParameterCount();
+                Value<Type[]> types = emit(() -> new Type[count]);
+                for (int i = 0; i < count; ++i) {
+                    int index = i;
+                    Value<Type> parameter = type(method.genericParameterType(i), cls, method, Map.of());
+                    emit(() -> types.get()[index] = parameter.get());
+                }
+                return types;
+            });
+            Value<Type[]> previous = result;
+            result = emit(() -> signature.get().matches(member.get()) ? resolved.get() : previous.get());
+        }
+        Value<Type[]> selected = result;
+        exit(() -> selected.get());
+    }
+
+    private static Value<TypeVariable<?>[]> parameters(GenericTypeParameter[] declared, ClassReader cls,
+            MethodReader method, Value<GenericDeclaration> declaration, Value<GenericMetadata> metadata) {
+        int count = declared != null ? declared.length : 0;
+        Value<TypeVariable<?>[]> parameters = emit(() -> new TypeVariable<?>[count]);
+        emit(() -> metadata.get().parameters = parameters.get());
+        Map<String, Value<GenericMetadata.Variable>> variables = new HashMap<>();
+        for (int i = 0; i < count; ++i) {
+            String name = declared[i].getName();
+            int index = i;
+            Value<GenericMetadata.Variable> variable = emit(() ->
+                    GenericMetadata.variablePlaceholder(declaration.get(), name));
+            variables.put(name, variable);
+            emit(() -> parameters.get()[index] = variable.get());
+        }
+        for (int i = 0; i < count; ++i) {
+            List<Value<Type>> bounds = new ArrayList<>();
+            if (declared[i].getClassBound() != null) {
+                bounds.add(type(declared[i].getClassBound(), cls, method, variables));
+            }
+            for (var bound : declared[i].getInterfaceBounds()) {
+                bounds.add(type(bound, cls, method, variables));
+            }
+            if (bounds.isEmpty()) {
+                bounds.add(emit(() -> Object.class));
+            }
+            Value<GenericMetadata.Variable> variable = variables.get(declared[i].getName());
+            int boundCount = bounds.size();
+            emit(() -> variable.get().initializeBounds(boundCount));
+            for (int j = 0; j < boundCount; ++j) {
+                int index = j;
+                Value<Type> bound = bounds.get(j);
+                emit(() -> variable.get().setBound(index, bound.get()));
+            }
+        }
+        return parameters;
+    }
+
+    private static Value<Type> type(GenericValueType type, ClassReader scope) {
+        return type(type, scope, null, Map.of());
+    }
+
+    private static Value<Type> type(GenericValueType type, ClassReader scope, MethodReader method,
+            Map<String, Value<GenericMetadata.Variable>> variables) {
+        if (type instanceof GenericValueType.Variable) {
+            String name = ((GenericValueType.Variable) type).getName();
+            Value<GenericMetadata.Variable> local = variables.get(name);
+            return local != null ? emit(() -> local.get()) : variable(name, scope, method);
+        }
+        if (type instanceof GenericValueType.Primitive) {
+            return raw(ValueType.primitive(((GenericValueType.Primitive) type).getKind()));
+        }
+        if (type instanceof GenericValueType.Array) {
+            Value<Type> component = type(((GenericValueType.Array) type).getItemType(), scope, method, variables);
+            return emit(() -> GenericTypes.array(component.get()));
+        }
+        if (!(type instanceof GenericValueType.Object)) {
+            getDiagnostics().error(getLocation(), "Unsupported generic type in " + scope.getName() + ": " + type);
+            return emit(() -> (Type) null);
+        }
+        GenericValueType.Object object = (GenericValueType.Object) type;
+        String name = binaryName(object);
+        ReflectClass<?> raw = findClass(name);
+        if (raw == null) {
+            return missingType(name);
+        }
+        GenericValueType.Argument[] arguments = object.getArguments();
+        if (arguments.length == 0 && !parameterized(object.getParent())) {
+            return emit(() -> raw.asJavaClass());
+        }
+        Value<Type> owner;
+        if (object.getParent() != null) {
+            owner = type(object.getParent(), scope, method, variables);
+        } else {
+            String declaring = reader(raw).getDeclaringClassName();
+            if (declaring == null) {
