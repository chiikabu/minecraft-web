+                });
+            }
+        }
+        List<Value<Type>> values = new ArrayList<>();
+        for (var argument : arguments) {
+            switch (argument.getKind()) {
+                case ANY:
+                    values.add(emit(() -> GenericTypes.wildcard(Object.class, null)));
+                    break;
+                case INVARIANT:
+                    values.add(type(argument.getValue(), scope, method, variables));
+                    break;
+                case COVARIANT: {
+                    Value<Type> upper = type(argument.getValue(), scope, method, variables);
+                    values.add(emit(() -> GenericTypes.wildcard(upper.get(), null)));
+                    break;
+                }
