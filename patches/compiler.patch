+                    if (parameter.getName().equals(name)) {
+                        ReflectClass<?> declaration = requireClass(current.getName());
+                        return emit(() -> GenericMetadata.variable(declaration.asJavaClass(), name));
+                    }
+                }
+            }
+            String declaring = current.getDeclaringClassName();
+            if (declaring != null) {
+                if (current.hasModifier(ElementModifier.STATIC)) break;
+                current = reader(requireClass(declaring));
+                continue;
+            }
+            MethodReference enclosing = current.getEnclosingMethod();
+            if (enclosing != null) {
+                ClassReader enclosingClass = reader(requireClass(enclosing.getClassName()));
+                MethodReader enclosingMethod = enclosingClass.getMethod(enclosing.getDescriptor());
+                if (enclosingMethod == null) throw new IllegalArgumentException("Missing enclosing method " + enclosing);
