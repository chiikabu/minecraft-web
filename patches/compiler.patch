+    private static Value<GenericMetadata.Signature> signature(MethodReference method) {
+        String name = method.getName();
+        String result = rawName(method.getReturnType());
+        int count = method.parameterCount();
+        Value<GenericMetadata.Signature> signature = emit(() ->
+                new GenericMetadata.Signature(name, result, count));
+        for (int i = 0; i < count; ++i) {
+            int index = i;
+            String argument = rawName(method.parameterType(i));
+            emit(() -> signature.get().setParameter(index, argument));
+        }
+        return signature;
+    }
+
+    private static String rawName(ValueType type) {
+        if (type instanceof ValueType.Object) {
+            return ((ValueType.Object) type).getClassName();
+        }
+        if (type instanceof ValueType.Array) {
+            return type.toString().replace('/', '.');
+        }
+        return rawClass(type).getName();
+    }
+
+    private static boolean parameterized(GenericValueType.Object type) {
+        return type != null && (type.getArguments().length > 0 || parameterized(type.getParent()));
+    }
+
+    private static String binaryName(GenericValueType.Object type) {
+        return type.getParent() == null ? type.getClassName()
+                : binaryName(type.getParent()) + "$" + type.getClassName();
+    }
+
+    private static Value<Type> raw(ValueType type) {
+        ReflectClass<?> cls = rawClass(type);
+        return emit(() -> cls.asJavaClass());
+    }
+
+    private static ReflectClass<?> rawClass(ValueType type) {
+        if (type instanceof ValueType.Object) {
+            return requireClass(((ValueType.Object) type).getClassName());
+        }
+        if (type instanceof ValueType.Array) {
+            return arrayClass(rawClass(((ValueType.Array) type).getItemType()));
+        }
+        if (type == ValueType.VOID) {
+            return findClass(void.class);
+        }
+        switch (((ValueType.Primitive) type).getKind()) {
+            case BOOLEAN: return findClass(boolean.class);
+            case BYTE: return findClass(byte.class);
+            case SHORT: return findClass(short.class);
+            case CHARACTER: return findClass(char.class);
+            case INTEGER: return findClass(int.class);
+            case LONG: return findClass(long.class);
+            case FLOAT: return findClass(float.class);
+            case DOUBLE: return findClass(double.class);
+            default: throw new AssertionError(type);
+        }
+    }
+
+    private static ReflectClass<?> requireClass(String name) {
+        ReflectClass<?> cls = findClass(name);
+        if (cls == null) {
+            throw new IllegalArgumentException("Generic reflection references missing class " + name);
+        }
+        return cls;
+    }
+
+    private static boolean missingOwner(ReflectClass<?> owner) {
+        String ownerName = owner.getName();
+        String name = findClass(ownerName) == null ? ownerName
+                : ((ReflectClassImpl<?>) owner).findMissingClassInHierarchy();
+        if (name == null) return false;
+        // Erased reflection signatures can name absent classes even on unexecuted branches.
+        exit(() -> {
+            NoClassDefFoundError error = new NoClassDefFoundError(name);
+            error.initCause(new ClassNotFoundException(name));
+            throw error;
+        });
+        return true;
+    }
+
+    private static ClassReader reader(ReflectClass<?> cls) {
+        ReflectClassImpl<?> implementation = (ReflectClassImpl<?>) cls;
+        implementation.resolve();
+        if (implementation.classReader == null) {
+            throw new IllegalArgumentException("No generic class model for " + cls.getName());
+        }
+        return implementation.classReader;
+    }
+}
