+                    result.add(e.getTargetIndex());
+                    result.add(e.getSourceArray());
+                    result.add(e.getSourceIndex());
+                    result.add(e.getSize());
+                    return result;
+                },
+                (e, args) -> {
+                    e.setTargetArray(args.get(0));
+                    e.setTargetIndex(args.get(1));
