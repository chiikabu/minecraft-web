+        for (int i = 0; i < argumentCount; ++i) {
+            int index = i;
+            Value<Type> argument = values.get(i);
+            emit(() -> result.get().setArgument(index, argument.get()));
+        }
+        return emit(() -> result.get());
+    }
+
+    private static Value<Type> missingType(String name) {
+        return emit(() -> {
+            throw new TypeNotPresentException(name, new ClassNotFoundException(name));
+        });
+    }
+
+    private static Value<Type> variable(String name, ClassReader scope, MethodReader method) {
+        if (method != null) {
+            for (GenericTypeParameter parameter : method.getTypeParameters()) {
