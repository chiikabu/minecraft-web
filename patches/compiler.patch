+package org.teavm.classlib.impl;
+
+import java.lang.reflect.Modifier;
+import java.util.Objects;
+import org.teavm.interop.Structure;
+import org.teavm.metaprogramming.CompileTime;
+import org.teavm.metaprogramming.Meta;
+import org.teavm.metaprogramming.ReflectClass;
+import org.teavm.metaprogramming.impl.reflect.ReflectClassImpl;
+import static org.teavm.metaprogramming.Metaprogramming.exit;
+import static org.teavm.metaprogramming.Metaprogramming.findClass;
+
+@CompileTime
+public final class UnsafeSupport {
+    private UnsafeSupport() { }
+
+    public static Object allocateInstance(Class<?> type) throws InstantiationException {
+        Objects.requireNonNull(type);
+        // Keep this call's class value out of requireNonNull's shared return flow.
+        Object instance = allocate(type);
+        if (instance == null) {
+            if (type == Class.class) {
+                UnsafeSupport.<RuntimeException>throwException(new IllegalAccessException(type.getName()));
+            }
+            throw new InstantiationException(type.getName());
+        }
+        return instance;
+    }
+
+    @Meta
+    private static native Object allocate(Class<?> type);
+
+    private static void allocate(ReflectClass<?> type) {
+        String missing = ((ReflectClassImpl<?>) type).findMissingClassInHierarchy();
+        if (missing != null) {
+            exit(() -> {
+                NoClassDefFoundError error = new NoClassDefFoundError(missing);
+                error.initCause(new ClassNotFoundException(missing));
+                throw error;
+            });
+            return;
+        }
+        // Structure types have no WasmGC struct; reflected signatures (Address.toStructure) bring them here.
+        if (type.isPrimitive() || type.isArray() || type.isInterface() || Modifier.isAbstract(type.getModifiers())
+                || type.getName().equals("java.lang.Class") || findClass(Structure.class).isAssignableFrom(type)) {
+            exit(() -> null);
+        } else {
+            exit(() -> type.allocateInstance());
+        }
+    }
+
+    // Unsafe.allocateInstance throws IllegalAccessException without declaring it on the JVM.
+    @SuppressWarnings("unchecked")
+    private static <E extends Throwable> void throwException(Throwable error) throws E {
+        throw (E) error;
+    }
+}
