+        while (model.getDispatchers().size() < count) {
+            int parameters = model.getMetaParameterCount();
+            ValueType[] signature = new ValueType[parameters + 2];
+            for (int i = 0; i < parameters; i++) signature[i] = model.getMetaParameterType(i);
+            signature[parameters] = ValueType.object("java.lang.String");
+            signature[parameters + 1] = model.getMethod().getReturnType();
+            var cls = new ClassHolder(agent.generateClassName());
+            cls.setParent("java.lang.Object");
+            var method = new MethodHolder("dispatch", signature);
+            method.getModifiers().add(ElementModifier.STATIC);
+            method.getModifiers().add(ElementModifier.NATIVE);
+            cls.addMethod(method);
+            agent.submitClass(cls);
+            agent.getIncrementalCache().setNoCache(cls.getName());
+            var dependency = agent.linkMethod(method.getReference());
+            dependency.addLocation(location);
+            int offset = model.isStatic() ? 1 : 0;
+            for (int i = 0; i < parameters; i++) {
+                if (i != model.getMetaClassParameterIndex()) {
+                    methodDep.getVariable(i + offset).connect(dependency.getVariable(i + 1));
+                }
+            }
+            dependency.getVariable(parameters + 1).propagate(agent.getType("java.lang.String"));
+            if (dependency.getResult() != null) dependency.getResult().connect(methodDep.getResult());
+            dependency.getThrown().connect(methodDep.getThrown());
+            dependency.use();
+            agent.linkClass(cls.getName());
+            model.getDispatchers().add(method.getReference());
+        }
+    }
+
+    private int trivialResult(Program original, MethodReference method) {
+        // ponytail: only simplify tiny return wrappers here; leave larger bodies to the backend.
+        if (original.basicBlockCount() == 0 || original.basicBlockCount() > 3) return -1;
+        int instructions = 0;
+        for (BasicBlock block : original.getBasicBlocks()) {
+            if (!block.getTryCatchBlocks().isEmpty()) return -1;
+            instructions += block.instructionCount();
+        }
+        if (instructions > 5) return -1;
+        Program program = ProgramUtils.copy(original);
+        Variable[] parameters = new Variable[method.parameterCount() + 1];
+        for (int i = 0; i < parameters.length; ++i) parameters[i] = program.variableAt(i);
+        RedundantJumpElimination.optimize(program);
+        new GlobalValueNumbering(false).optimize(program);
+        BasicBlock block = program.basicBlockAt(0);
+        if (program.basicBlockCount() == 2 && block.instructionCount() == 1
+                && block.getPhis().isEmpty() && block.getFirstInstruction() instanceof JumpInstruction jump
+                && jump.getTarget() == program.basicBlockAt(1)) {
+            block = program.basicBlockAt(1);
+        } else if (program.basicBlockCount() != 1) {
+            return -1;
+        }
+        if (block.getPhis().isEmpty() && block.instructionCount() == 3
+                && method.getReturnType() instanceof ValueType.Array arrayType
+                && block.getFirstInstruction() instanceof IntegerConstantInstruction size
+                && size.getConstant() == 0
+                && size.getNext() instanceof ConstructArrayInstruction array
+                && array.getSize() == size.getReceiver()
+                && array.getItemType().equals(arrayType.getItemType())
+                && array.getNext() instanceof ExitInstruction arrayExit
+                && arrayExit.getValueToReturn() == array.getReceiver()) {
+            return parameters.length;
+        }
+        if (instructions > 4) return -1;
+        if (block.instructionCount() != 1 || !block.getPhis().isEmpty()
+                || !(block.getFirstInstruction() instanceof ExitInstruction exit)) return -1;
+        if (exit.getValueToReturn() == null) return method.getReturnType() == ValueType.VOID ? 0 : -1;
+        for (int i = 1; i < parameters.length; ++i) {
+            if (exit.getValueToReturn() == parameters[i]) return i;
+        }
+        return -1;
+    }
