@@ -0,0 +1,100 @@
+package org.teavm.diagnostics;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayDeque;
+import java.util.HashSet;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Set;
+import org.teavm.callgraph.CallGraph;
+import org.teavm.callgraph.CallGraphNode;
+import org.teavm.model.MethodReference;
+import org.teavm.model.CallLocation;
+import org.teavm.model.ValueType;
+
+/** Opt-in JVM linkage behavior for code reachable only through reflective execution. */
+public final class ReflectionLinkageDiagnostics extends AccumulationDiagnostics {
+    private static final Set<String> LINKAGE_ERRORS = Set.of(
+            "Class {{c0}} was not found", "Method {{m0}} was not found", "Field {{f0}} was not found");
+    private static final Set<MethodReference> REFLECTION = Set.of(
+            new MethodReference("org.teavm.classlib.impl.UnsafeSupport", "allocateInstance",
+                    ValueType.object("java.lang.Class"), ValueType.object("java.lang.Object")),
+            new MethodReference("org.teavm.classlib.impl.reflection.ClassSupport", "getEnumConstants",
+                    ValueType.object("java.lang.Class"), ValueType.arrayOf(ValueType.object("java.lang.Enum"))),
+            new MethodReference(Method.class, "invoke", Object.class, Object[].class, Object.class),
+            new MethodReference(Constructor.class, "newInstance", Object[].class, Object.class),
+            new MethodReference(Constructor.class, "newInstance0", Object[].class, Object.class),
+            new MethodReference(Field.class, "getWithoutCheck", Object.class, Object.class),
+            new MethodReference(Field.class, "setWithoutCheck", Object.class, Object.class, void.class),
+            new MethodReference(Class.class, "newInstance", Object.class),
+            new MethodReference(Class.class, "initialize", boolean.class, void.class),
+            new MethodReference(Class.class, "initialize", void.class));
+
+    private final boolean enabled;
+    private CallGraph graph;
+    private final Set<Problem> linkageProblems = Collections.newSetFromMap(new IdentityHashMap<>());
+
+    public ReflectionLinkageDiagnostics(boolean enabled) {
+        this.enabled = enabled;
+    }
+
+    public void setCallGraph(CallGraph graph) {
+        this.graph = graph;
+    }
+
+    public void linkageError(CallLocation location, String message, Object... params) {
+        super.error(location, message, params);
+        var errors = super.getSevereProblems();
+        linkageProblems.add(errors.get(errors.size() - 1));
+    }
+
+    @Override
+    public List<Problem> getSevereProblems() {
+        var errors = super.getSevereProblems();
+        if (!enabled || errors.isEmpty()) return errors;
+        return errors.stream().filter(error -> !isOptional(error)).toList();
+    }
+
+    @Override
+    public List<Problem> getProblems() {
+        if (!enabled) return super.getProblems();
+        return super.getProblems().stream().map(error -> isOptional(error)
+                ? new Problem(ProblemSeverity.WARNING, error.getLocation(),
+                        "Optional reflective code will throw a JVM linkage error if executed: " + error.getText(),
+                        error.getParams()) : error).toList();
+    }
+
+    private boolean isOptional(Problem error) {
+        if (graph == null || !linkageProblems.contains(error) || error.getSeverity() != ProblemSeverity.ERROR
+                || !LINKAGE_ERRORS.contains(error.getText()) || error.getLocation() == null
+                || error.getLocation().getMethod() == null) return false;
+        CallGraphNode start = graph.getNode(error.getLocation().getMethod());
+        if (start == null) return false;
+        var pending = new ArrayDeque<CallGraphNode>();
+        var seen = new HashSet<CallGraphNode>();
+        pending.add(start);
+        seen.add(start);
+        boolean reflective = false;
+        // ponytail: rewalk the graph so late ordinary callers restore fatal errors; cache only with graph revisions.
+        while (!pending.isEmpty()) {
+            var node = pending.removeLast();
+            var sites = node.getCallerCallSites();
+            if (sites.isEmpty()) return false;
+            for (var site : sites) {
+                if (site.getCallers().isEmpty()) return false;
+                for (var caller : site.getCallers()) {
+                    if (caller.getMethod() == null) return false;
+                    if (REFLECTION.contains(caller.getMethod())) {
+                        reflective = true;
+                    } else if (seen.add(caller)) {
+                        pending.add(caller);
+                    }
+                }
+            }
+        }
+        return reflective;
+    }
+}
